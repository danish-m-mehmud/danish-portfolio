---
layout: base.njk
---
<article class="case">
  <a class="back" href="{{ '/#work' | url }}">All work</a>
  <header class="case-header">
    <p class="meta">{{ domain }} · {{ employer }}</p>
    <h1>{{ title }}</h1>
    <p class="lede">{{ description }}</p>
  </header>
  <div class="prose">{{ content | safe }}</div>
</article>
